		ioconfig2: ioconfig@179f0000 {
			compatible = "hisilicon,hi3519dv500-ioconfig2";
			reg = <0x179f0000 0x10000>;

			i2c3_pins: i2c3-pins {
				pinmux = <HI3519DV500_PINMUX(0x28, 2)>,
					 <HI3519DV500_PINMUX(0x2c, 2)>;
			};

			i2c4_pins: i2c4-pins {
				pinmux = <HI3519DV500_PINMUX(0x30, 2)>,
					 <HI3519DV500_PINMUX(0x34, 2)>;
			};

			i2c7_pins: i2c7-pins {
				pinmux = <HI3519DV500_PINMUX(0x00, 2)>,
					 <HI3519DV500_PINMUX(0x04, 2)>;
			};

			spi0_pins: spi0-pins {
				pinmux = <HI3519DV500_PINMUX(0x34, 1)>,
					 <HI3519DV500_PINMUX(0x2c, 1)>,
					 <HI3519DV500_PINMUX(0x30, 1)>,
					 <HI3519DV500_PINMUX(0x28, 1)>,
					 <HI3519DV500_PINMUX(0x24, 1)>;
			};

			pwm0_out0_pins: pwm0-out0-pins {
				pinmux = <HI3519DV500_PINMUX(0x1c, 1)>;
			};

			pwm0_out1_pins: pwm0-out1-pins {
				pinmux = <HI3519DV500_PINMUX(0x20, 1)>;
			};

			pwm0_out2_pins: pwm0-out2-pins {
				pinmux = <HI3519DV500_PINMUX(0x70, 2)>;
			};

			pwm0_out4_pins: pwm0-out4-pins {
				pinmux = <HI3519DV500_PINMUX(0x54, 2)>;
			};

			pwm0_out5_pins: pwm0-out5-pins {
				pinmux = <HI3519DV500_PINMUX(0x24, 4)>;
			};

			pwm1_out0_pins: pwm1-out0-pins {
				pinmux = <HI3519DV500_PINMUX(0x38, 4)>;
			};

			pwm1_out1_pins: pwm1-out1-pins {
				pinmux = <HI3519DV500_PINMUX(0x3c, 4)>;
			};

			pwm1_out2_pins: pwm1-out2-pins {
				pinmux = <HI3519DV500_PINMUX(0x40, 4)>;
			};

			pwm1_out3_pins: pwm1-out3-pins {
				pinmux = <HI3519DV500_PINMUX(0x44, 4)>;
			};

			pwm1_out4_pins: pwm1-out4-pins {
				pinmux = <HI3519DV500_PINMUX(0x58, 2)>;
			};

			pwm1_out5_pins: pwm1-out5-pins {
				pinmux = <HI3519DV500_PINMUX(0xa4, 2)>;
			};

			lsadc_pins: lsadc-pins {
				pinmux = <HI3519DV500_PINMUX(0x00, 0)>,
					 <HI3519DV500_PINMUX(0x04, 0)>,
					 <HI3519DV500_PINMUX(0x08, 0)>,
					 <HI3519DV500_PINMUX(0x0c, 0)>;
			};
		};
	};
