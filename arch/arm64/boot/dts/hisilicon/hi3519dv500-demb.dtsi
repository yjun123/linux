/*
 * Common part of the HiSilicon Hi3519DV500 DEMB evaluation boards.
 * The board carries the console UART, the RTC, the eight I2C buses,
 * the GPIO banks, the four SPI buses with their native chip selects,
 * the LSADC, the first PWM block, the SD card slot
 * and the RGMII Ethernet port with its PHY on the MDIO bus.  It
 * boots from either the SPI NOR flash or the eMMC, which share the
 * serial flash pads, so the boot variant dts files enable exactly
 * one of the two devices.
 */

#include "hi3519dv500.dtsi"

/ {
	vref_1v8: regulator-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "lsadc-vref";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};
};

&uart0 {
	status = "okay";
};

&rtc {
	status = "okay";
};

&i2c0 {
	status = "okay";
};

&i2c1 {
	status = "okay";
};

&i2c2 {
	status = "okay";
};

&i2c3 {
	status = "okay";
};

&i2c4 {
	status = "okay";
};

&i2c5 {
	status = "okay";
};

&i2c6 {
	status = "okay";
};

&i2c7 {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpio2 {
	status = "okay";
};

&gpio3 {
	status = "okay";
};

&gpio4 {
	status = "okay";
};

&gpio5 {
	status = "okay";
};

&gpio6 {
	status = "okay";
};

&gpio7 {
	status = "okay";
};

&gpio8 {
	status = "okay";
};

&gpio9 {
	status = "okay";
};

&gpio10 {
	status = "okay";
};

&gpio11 {
	status = "okay";
};

&gpio12 {
	status = "okay";
};

&gpio13 {
	status = "okay";
};

&gpio14 {
	status = "okay";
};

&spi0 {
	status = "okay";

	spidev@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <25000000>;
	};

	spidev@1 {
		compatible = "rohm,dh2228fv";
		reg = <1>;
		spi-max-frequency = <25000000>;
	};
};

&spi1 {
	status = "okay";

	spidev@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <25000000>;
	};
};

&spi2 {
	status = "okay";

	spidev@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <25000000>;
	};
};

&spi3 {
	status = "okay";

	spidev@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <25000000>;
	};

	spidev@1 {
		compatible = "rohm,dh2228fv";
		reg = <1>;
		spi-max-frequency = <25000000>;
	};
};

&lsadc {
	vref-supply = <&vref_1v8>;
	status = "okay";
};

&pwm0 {
	status = "okay";
};

&mmc1 {
	status = "okay";
};

&mdio {
	status = "okay";

	ethphy: ethernet-phy@1 {
		reg = <1>;
	};
};

&gmac {
	phy-handle = <&ethphy>;
	phy-mode = "rgmii-id";
	status = "okay";
};
