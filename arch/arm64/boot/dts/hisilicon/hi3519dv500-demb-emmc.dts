/dts-v1/;

#include "hi3519dv500-demb.dtsi"

/ {
	model = "HiSilicon Hi3519DV500 DEMB (eMMC)";
	compatible = "hisilicon,hi3519dv500-demb", "hisilicon,hi3519dv500";

	aliases {
		serial0 = &uart0;

		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		i2c4 = &i2c4;
		i2c5 = &i2c5;
		i2c6 = &i2c6;
		i2c7 = &i2c7;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs = "earlycon=pl011,0x11040000 console=ttyAMA0,115200";
	};

	memory@40030000 {
		device_type = "memory";
		reg = <0x0 0x40030000 0x0 0x40000000>;
	};
};

&mmc0 {
	status = "okay";
};
