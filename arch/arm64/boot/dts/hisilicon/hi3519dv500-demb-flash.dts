/dts-v1/;

#include "hi3519dv500-demb.dtsi"

/ {
	model = "HiSilicon Hi3519DV500 DEMB (NOR flash)";
	compatible = "hisilicon,hi3519dv500-demb", "hisilicon,hi3519dv500";

	aliases {
		serial0 = &uart0;

		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		i2c4 = &i2c4;
		i2c5 = &i2c5;
		i2c6 = &i2c6;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		/*
		 * U-Boot rewrites this property in place with strlcpy() using
		 * its "bootargs" environment variable.  The property must be
		 * large enough for that value, otherwise the write overruns
		 * into the following FDT structure block and the kernel fails
		 * early_init_dt_scan() before the console is up.
		 * Reserve COMMAND_LINE_SIZE (1024) bytes.
		 */
		bootargs = "earlycon=pl011,0x11040000 console=ttyAMA0,115200 bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs-placeholder-bootargs";
	};

	memory@40030000 {
		device_type = "memory";
		reg = <0x0 0x40030000 0x0 0x40000000>;
	};
};

&fmc {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <100000000>;
	};
};

&i2c5 {
	status = "okay";
};

&i2c6 {
	status = "okay";
};

&spi1 {
	status = "okay";

	spidev@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <25000000>;
	};
};
