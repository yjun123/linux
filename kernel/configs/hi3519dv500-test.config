# HiSilicon Hi3519DV500 test fragment: platform drivers of the
# Hi3519DV500 SoC series, merged on top of the multi_v8 defconfig.
#
#    make ARCH=arm64 defconfig
#    ./scripts/kconfig/merge_config.sh -m .config kernel/configs/hi3519dv500-test.config
#    make ARCH=arm64 olddefconfig
#
# Clock, pinctrl and reset (reset provider is part of the clock
# controller driver).
CONFIG_COMMON_CLK_HI3519DV500=y
CONFIG_PINCTRL_HI3519DV500=y

# I2C controllers and the on-board EEPROMs.
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_HI3519DV500=y
CONFIG_EEPROM_AT24=y

# EDMAC v310 DMA engine.
CONFIG_HISI_EDMACV310=y

# FMC v100 flash: SPI NOR and SPI NAND modes.
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_CMDLINE_PARTS=y
CONFIG_MTD_SPI_NOR=y
CONFIG_SPI_HISI_FMCV100_FLASH=y
CONFIG_MTD_SPI_NAND=y
CONFIG_MTD_UBI=y
CONFIG_UBIFS_FS=y
CONFIG_JFFS2_FS=y

# eMMC / SD storage.
CONFIG_MMC_SDHCI_OF_DWCMSHC=y

# DWC3 USB controller, dual role, with its USB2 and combo PHYs.
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_GENERIC_PLAT=y
CONFIG_PHY_HI3519DV500_USB=y
CONFIG_USB_STORAGE=y

# GEMAC v5 Ethernet MAC and its MDIO bus.
CONFIG_HISI_GMAC_V5=y
CONFIG_MDIO_HISI_GEMAC=y

# Peripherals: thermal, RTC, PWM, LSADC, watchdog and the BMI088 IMU.
CONFIG_HISI_THERMAL=y
CONFIG_RTC_DRV_HI3519DV500=y
CONFIG_PWM_HI3519DV500=y
CONFIG_HI3519DV500_LSADC=y
CONFIG_ARM_SP805_WATCHDOG=y
CONFIG_BMI088_ACCEL=y
